$(document).ready(function () {

    let products = [];
    let cart = [];




    function loadProducts() {

        let saved = localStorage.getItem("localItems");

        if (saved !== null) {
            try {
                let data = JSON.parse(saved);
                if (!Array.isArray(data.items)) {
                    throw new Error("Invalid product data");
                }
                products = data.items;
                displayProducts();
                return;
            } catch (error) {
                console.error("Saved products could not be loaded.", error);
            }
        }

        $.getJSON("cart.json", function (data) {
            products = data.items;
            displayProducts();
        }).fail(function () {
            showStatus("Unable to load cart.json.", "danger");
        });
    }



    function displayProducts() {

        let search = $("#searchInput").val().toLowerCase();
        let category = $("#categoryFilter").val();

        $("#productTableBody").empty();

        let count = 0;

        $.each(products, function (index, product) {

            let matchesSearch =
                product.itemId.toLowerCase().includes(search) ||
                product.itemTitle.toLowerCase().includes(search) ||
                product.itemCategory.toLowerCase().includes(search);

            let matchesCategory =
                category === "" ||
                product.itemCategory === category;

            if (matchesSearch && matchesCategory) {

                let row = $("<tr>");

                $("<td>").text(product.itemId).appendTo(row);
                $("<td>").text(product.itemTitle).appendTo(row);
                $("<td>").text(product.itemCategory).appendTo(row);
                $("<td>").text(product.itemUnit).appendTo(row);

                $("<td>")
                    .text("$" + Number(product.itemPrice).toFixed(2))
                    .appendTo(row);

                $("<td>")
                    .text(product.itemInfo || "—")
                    .appendTo(row);

                let actions = $("<td>").addClass("text-end");

                $("<button>")
                    .text("Add to Cart")
                    .addClass("btn btn-primary btn-sm add-to-cart-btn")
                    .attr("data-id", product.itemId)
                    .appendTo(actions);

                row.append(actions);
                $("#productTableBody").append(row);

                count++;
            }
        });

        $("#productCount").text(count);
        $("#noResultsMessage").toggleClass("d-none", count !== 0);
    }



    $("#searchInput").on("input", function () {
        displayProducts();
    });

    $("#categoryFilter").on("change", function () {
        displayProducts();
    });



    $("#productTableBody").on("click", ".add-to-cart-btn", function () {

        let id = $(this).attr("data-id");

        let product = products.find(function (item) {
            return item.itemId === id;
        });

        if (!product) {
            showStatus("Product not found.", "danger");
            return;
        }

        let price = Number(product.itemPrice);

        if (!Number.isFinite(price) || price < 0) {
            showStatus("Invalid product price.", "danger");
            return;
        }

        let existingItem = cart.find(function (item) {
            return item.itemId === id;
        });

        if (existingItem) {
            existingItem.quantity++;
        } else {
            cart.push({
                itemId: product.itemId,
                itemTitle: product.itemTitle,
                itemCategory: product.itemCategory,
                itemUnit: product.itemUnit,
                itemPrice: price,
                itemInfo: product.itemInfo || "",
                quantity: 1
            });
        }

        saveCart();
        displayCart();

        showStatus("Product added to cart successfully!", "success");
    });




    function displayCart() {

        $("#cartTableBody").empty();

        let total = 0;
        let count = 0;

        $.each(cart, function (index, item) {

            let subtotal = item.itemPrice * item.quantity;

            total += subtotal;
            count += item.quantity;

            let row = $("<tr>");

            $("<td>").text(item.itemId).appendTo(row);
            $("<td>").text(item.itemTitle).appendTo(row);

            $("<td>")
                .text("$" + Number(item.itemPrice).toFixed(2))
                .appendTo(row);

            let quantityCell = $("<td>");

            $("<input>")
                .attr({
                    type: "number",
                    min: 1,
                    max: 999,
                    step: 1,
                    "data-id": item.itemId
                })
                .addClass("form-control form-control-sm cart-qty")
                .val(item.quantity)
                .appendTo(quantityCell);

            row.append(quantityCell);

            $("<td>")
                .text("$" + subtotal.toFixed(2))
                .appendTo(row);

            let actions = $("<td>").addClass("text-end");

            $("<button>")
                .text("Remove")
                .addClass("btn btn-outline-danger btn-sm remove-from-cart-btn")
                .attr("data-id", item.itemId)
                .appendTo(actions);

            row.append(actions);
            $("#cartTableBody").append(row);
        });

        $("#cartCount").text(count);
        $("#cartTotal").text("$" + total.toFixed(2));

        $("#emptyCartMessage").toggleClass("d-none", cart.length !== 0);
        $("#checkoutBtn").prop("disabled", cart.length === 0);
    }




    $("#cartTableBody").on("change", ".cart-qty", function () {

        let id = $(this).attr("data-id");
        let quantityText = $(this).val().trim();
        let quantity = Number(quantityText);

        if (
            quantityText === "" ||
            !Number.isInteger(quantity) ||
            quantity < 1 ||
            quantity > 999
        ) {
            showStatus(
                "Quantity must be a whole number between 1 and 999.",
                "danger"
            );

            displayCart();
            return;
        }

        let item = cart.find(function (product) {
            return product.itemId === id;
        });

        if (item) {
            item.quantity = quantity;

            saveCart();
            displayCart();

            showStatus("Quantity updated successfully!", "success");
        }
    });



    $("#cartTableBody").on("click", ".remove-from-cart-btn", function () {

        let id = $(this).attr("data-id");

        cart = cart.filter(function (item) {
            return item.itemId !== id;
        });

        saveCart();
        displayCart();

        showStatus("Product removed from cart.", "success");
    });

 
    $("#clearCartBtn").on("click", function () {

        if (cart.length === 0) {
            showStatus("Your cart is already empty.", "danger");
            return;
        }

        if (confirm("Are you sure you want to clear your cart?")) {

            cart = [];

            saveCart();
            displayCart();

            showStatus("Cart cleared successfully!", "success");
        }
    });


    function saveCart() {
        localStorage.setItem("shoppingCart", JSON.stringify(cart));
    }

    function loadCart() {

        let savedCart = localStorage.getItem("shoppingCart");

        if (savedCart) {
            try {
                let data = JSON.parse(savedCart);
                if (Array.isArray(data)) {
                    cart = data.filter(function (item) {
                        return Number.isInteger(item.quantity) &&
                               item.quantity >= 1 &&
                               item.quantity <= 999 &&
                               Number.isFinite(Number(item.itemPrice)) &&
                               Number(item.itemPrice) >= 0;
                    });
                }
            } catch (error) {
                cart = [];
            }
        }

        displayCart();
    }


    function showStatus(message, type) {

        $("#statusMessage")
            .removeClass("d-none alert-success alert-danger alert-info")
            .addClass("alert-" + type)
            .text(message);
    }



    $("#checkoutBtn").on("click", function () {

        if (cart.length === 0) {
            showStatus("Your cart is empty.", "danger");
            return;
        }

        let order = {
            items: cart.map(function (item) {
                return {
                    itemId: item.itemId,
                    description: item.itemTitle,
                    category: item.itemCategory,
                    unit: item.itemUnit,
                    price: Number(item.itemPrice),
                    quantity: item.quantity
                };
            }),
            total: Number($("#cartTotal").text().replace("$", ""))
        };

        let jsonData = JSON.stringify(order, null, 2);

        console.log("JSON data prepared for REST API:");
        console.log(jsonData);

        // Future REST API endpoint.
        // Leave blank until the backend is developed.
        let apiUrl = "";

        if (apiUrl === "") {
            showStatus(
                "Checkout JSON prepared! View it in the browser console. API connection will be added later.",
                "info"
            );
            return;
        }

        // AJAX request for future REST API
        $.ajax({
            url: apiUrl,
            type: "POST",
            contentType: "application/json",
            dataType: "json",
            data: JSON.stringify(order),

            success: function (response) {
                showStatus("Order submitted successfully!", "success");
                console.log("API response:", response);

                cart = [];
                saveCart();
                displayCart();
            },

            error: function (xhr, status, error) {
                showStatus("Unable to submit order.", "danger");
                console.error("AJAX error:", error);
            }
        });
    });


    loadProducts();
    loadCart();

});